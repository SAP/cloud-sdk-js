{
  "extends": ["github>sap/ai-sdk-js//.github/renovate.jsonc"],
  "packageRules": [
    {
      // These packages require ESM in their next major version, stay on current major until we support ESM
      "matchPackageNames": ["execa", "yargs", "@stylistic/eslint-plugin"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
