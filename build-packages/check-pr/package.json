{
  "name": "check-pr",
  "version": "2.12.0",
  "description": "Checks the current PR for semantical correctness and appropriate changelog.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "postcompile": "rolldown -c rolldown.config.ts",
    "test": "pnpm run test:unit",
    "test:unit": "NODE_OPTIONS=--experimental-vm-modules pnpm exec jest",
    "lint": "eslint --ignore-pattern '!index.ts' && prettier --check **/*.ts",
    "lint:fix": "eslint --ignore-pattern '!index.ts' --fix --quiet && prettier --write **/*.ts",
    "all": "pnpm install && pnpm run lint && pnpm run compile"
  },
  "dependencies": {
    "@actions/core": "^3.0.0",
    "@actions/github": "^9.1.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@sap-cloud-sdk/test-util-build-internal": "workspace:^",
    "eslint": "10.9.1",
    "memfs": "4.68.2",
    "rolldown": "1.2.5",
    "prettier": "3.9.6"
  }
}
