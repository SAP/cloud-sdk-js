{
  "name": "@sap-cloud-sdk/integration-tests",
  "version": "4.8.0",
  "description": "SAP Cloud SDK for JavaScript integration tests",
  "homepage": "https://sap.github.io/cloud-sdk/docs/js/overview",
  "license": "Apache-2.0",
  "private": true,
  "repository": "github:SAP/cloud-sdk-js",
  "scripts": {
    "test": "pnpm run test:integration",
    "test:integration": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js",
    "coverage": "node --experimental-vm-modules ../../node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint --ext .ts . && prettier . --config ../../.prettierrc --ignore-path ../../.prettierignore -c",
    "lint:fix": "TIMING=1 eslint --ext .ts . --fix --quiet && prettier . --config ../../.prettierrc --ignore-path ../../.prettierignore -w --log-level error"
  },
  "dependencies": {
    "@sap-cloud-sdk/connectivity": "workspace:^",
    "@sap-cloud-sdk/http-client": "workspace:^",
    "@sap-cloud-sdk/test-services-odata-v2": "workspace:^",
    "@sap-cloud-sdk/test-services-odata-v4": "workspace:^",
    "@sap-cloud-sdk/test-util": "workspace:^",
    "@sap-cloud-sdk/test-util-internal": "workspace:^",
    "@sap-cloud-sdk/util": "workspace:^",
    "@sap/xssec": "^4.13.0",
    "axios": "^1.15.0"
  },
  "devDependencies": {
    "@sap-cloud-sdk/generator": "workspace:^",
    "@sap-cloud-sdk/odata-common": "workspace:^",
    "@sap-cloud-sdk/odata-v2": "workspace:^",
    "@sap-cloud-sdk/openapi-generator": "workspace:^",
    "@sap-cloud-sdk/test-util-internal": "*",
    "@jest/globals": "30.4.1",
    "bignumber.js": "11.1.5",
    "jsonwebtoken": "9.0.3",
    "memfs": "4.68.1",
    "moment": "2.30.1",
    "nock": "14.0.17",
    "prettier": "3.9.6",
    "tinyexec": "1.3.0",
    "winston": "3.19.0"
  }
}
